# Copy this file to .env and fill in real values. Never commit .env.
# Keep any Firebase service-account JSON file OUTSIDE the repo folder.

# --- Backend Environment Variables (.env) ---

# Gemini API access key
GEMINI_API_KEY=

# Exact Gemini Flash model name
GEMINI_MODEL=

# Comma-separated fallback Gemini model names
GEMINI_FALLBACK_MODELS=

# Firebase project ID
FIREBASE_PROJECT_ID=

# Firebase Storage bucket name
FIREBASE_STORAGE_BUCKET=

# Path to service-account JSON outside the repo (for laptop scripts against real Firebase; leave commented for local emulator runs)
# GOOGLE_APPLICATION_CREDENTIALS=

# Local Firestore emulator host and port (e.g. 127.0.0.1:8080)
FIRESTORE_EMULATOR_HOST=

# Local Firebase Auth emulator host and port (e.g. 127.0.0.1:9099)
FIREBASE_AUTH_EMULATOR_HOST=

# Local Cloud Storage emulator URL (e.g. http://127.0.0.1:9199)
STORAGE_EMULATOR_HOST=

# Path to course data directory outside repo
COURSE_DATA_DIR=

# Allowed origins for CORS
CORS_ORIGINS=


# --- Frontend Environment Variables (belong in frontend/.env.local) ---

# Backend API base URL
NEXT_PUBLIC_API_BASE_URL=

# Firebase Web API key
NEXT_PUBLIC_FIREBASE_API_KEY=

# Firebase Web Auth domain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Firebase Web project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Web App ID
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to true for local development to route auth to the local Auth emulator
NEXT_PUBLIC_USE_EMULATORS=
